{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gametr.dev/schemas/common.json",
  "definitions": {
    "EntryStatus": {
      "title": "EntryStatus",
      "description": "条目状态机（M1）：1=PENDING 2=MACHINE 3=EDITED 4=CONFIRMED。一键重翻不得覆盖 CONFIRMED。",
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "ProjectState": {
      "title": "ProjectState",
      "description": "项目生命周期（M1 pipeline.py）：Created→Detecting→Extracted→Translating⇄Reviewing→WritingBack→Done。非法迁移抛异常。",
      "type": "string",
      "enum": [
        "created",
        "detecting",
        "extracted",
        "translating",
        "reviewing",
        "writing_back",
        "done"
      ]
    },
    "DetectResult": {
      "title": "DetectResult",
      "description": "detect.run 返回值：引擎识别 + 置信度（M2）。",
      "type": "object",
      "properties": {
        "engine_id": {
          "type": "string",
          "description": "引擎标识，如 rpgmv"
        },
        "display_name": {
          "type": "string",
          "description": "展示名，如 RPG Maker MV/MZ"
        },
        "version": {
          "type": "string",
          "description": "探测到的引擎版本"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0..1 置信度"
        },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "description": "插件自定义附加信息"
        }
      },
      "required": [
        "engine_id",
        "display_name",
        "confidence"
      ]
    },
    "ProgressEvent": {
      "title": "ProgressEvent",
      "description": "长任务进度通知（M3 起服务端推送，JSON-RPC 通知无 id）。progress 一个方法覆盖全部任务生命周期（看 status 区分）。",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "description": "extract / translate / write_back"
        },
        "done": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "ts": {
          "type": "number",
          "description": "事件时间戳（秒）"
        },
        "status": {
          "type": "string",
          "description": "任务生命周期：running/paused/cancelled/done/error（终态也要发一条）",
          "enum": [
            "running",
            "paused",
            "cancelled",
            "done",
            "error"
          ]
        },
        "skipped": {
          "type": "integer",
          "description": "续翻/缓存命中已跳过的条数（前端进度条从非零起步）"
        }
      },
      "required": [
        "task_id",
        "phase",
        "done",
        "total"
      ]
    },
    "PingResult": {
      "title": "PingResult",
      "description": "M0 健康检查：GUI 启动时 500ms 间隔重试直到成功。",
      "type": "object",
      "properties": {
        "pong": {
          "type": "boolean",
          "const": true
        },
        "version": {
          "type": "string",
          "description": "核心版本"
        },
        "pid": {
          "type": "integer",
          "description": "sidecar 进程号"
        },
        "ts": {
          "type": "number",
          "description": "服务器时间戳（秒）"
        }
      },
      "required": [
        "pong",
        "version",
        "pid",
        "ts"
      ]
    },
    "Entry": {
      "title": "Entry",
      "description": "M1 IR 数据模型。locator 不透明（ADR-0003），核心只存不解析。",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "稳定 ID：sha1(engine_id + locator标准化 + source前256字符)[:16]"
        },
        "source": {
          "type": "string"
        },
        "translation": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/EntryStatus"
        },
        "locator": {
          "type": "string",
          "description": "不透明定位串，插件负责生成与解析"
        },
        "context_json": {
          "type": [
            "string",
            "null"
          ],
          "description": "上下文元信息 JSON 串"
        },
        "warnings_json": {
          "type": [
            "string",
            "null"
          ],
          "description": "警告列表 JSON 串"
        },
        "updated_at": {
          "type": "number",
          "description": "更新时间戳（秒）"
        }
      },
      "required": [
        "id",
        "source",
        "status",
        "locator",
        "updated_at"
      ]
    },
    "RpcError": {
      "title": "RpcError",
      "description": "JSON-RPC error 对象（-32700..-32000，错误码表见 rpc-methods.json）。",
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "description": "可选附加数据"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "GlossaryEntry": {
      "title": "GlossaryEntry",
      "description": "术语表条目（M1）。",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "term": {
          "type": "string"
        },
        "translation": {
          "type": "string"
        },
        "match_case": {
          "type": "boolean",
          "description": "是否区分大小写匹配"
        }
      },
      "required": [
        "id",
        "term",
        "translation"
      ]
    },
    "Page": {
      "title": "Page",
      "description": "通用分页结果（M1）：items 为 Entry[]。",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Entry"
          }
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "items",
        "page",
        "page_size",
        "total"
      ]
    },
    "ProjectInfo": {
      "title": "ProjectInfo",
      "description": "project.create / project.open 返回值（M1）。",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "engine_id": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "project_state": {
          "$ref": "#/definitions/ProjectState"
        },
        "schema_version": {
          "type": "integer",
          "description": "项目文件 schema 版本（meta 表记录）"
        },
        "created_at": {
          "type": "number",
          "description": "创建时间戳（秒）"
        }
      },
      "required": [
        "path",
        "engine_id",
        "source_path",
        "project_state",
        "schema_version",
        "created_at"
      ]
    },
    "ProjectStats": {
      "title": "ProjectStats",
      "description": "project.stats 返回值：条目总数 + 状态分布（M1）。",
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "by_status": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "status int -> 计数"
        }
      },
      "required": [
        "total",
        "by_status"
      ]
    },
    "ExtractResult": {
      "title": "ExtractResult",
      "description": "extract.run 返回值（M2，M1 定义类型）。",
      "type": "object",
      "properties": {
        "engine_id": {
          "type": "string"
        },
        "extracted_count": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "number"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "engine_id",
        "extracted_count",
        "duration_ms"
      ]
    },
    "WriteBackResult": {
      "title": "WriteBackResult",
      "description": "write_back 返回值（M2，M1 定义类型）。",
      "type": "object",
      "properties": {
        "output_dir": {
          "type": "string"
        },
        "written_count": {
          "type": "integer"
        },
        "warning_count": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "output_dir",
        "written_count",
        "warning_count"
      ]
    },
    "PluginInfo": {
      "title": "PluginInfo",
      "description": "plugins.list 返回值：已加载插件信息（含 disabled 状态与失败原因，M2）。",
      "type": "object",
      "properties": {
        "engine_id": {
          "type": "string",
          "description": "引擎标识，如 rpgmv"
        },
        "display_name": {
          "type": "string",
          "description": "展示名，如 RPG Maker MV/MZ"
        },
        "version": {
          "type": "string",
          "description": "插件版本（semver）"
        },
        "api_version": {
          "type": "string",
          "description": "插件 API 版本契约"
        },
        "entry": {
          "type": "string",
          "description": "适配器入口文件名，如 adapter.py"
        },
        "loaded": {
          "type": "boolean",
          "description": "是否加载成功并可用（契约测试通过）"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "加载失败原因；loaded=false 时有值"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "插件可选能力列表（feature-detect）：如 protect=占位符保护器"
        }
      },
      "required": [
        "engine_id",
        "display_name",
        "version",
        "api_version",
        "entry",
        "loaded"
      ]
    },
    "TranslateStatus": {
      "title": "TranslateStatus",
      "description": "翻译任务生命周期（M3，任务表细粒度，不进项目状态机）。",
      "type": "string",
      "enum": [
        "running",
        "paused",
        "cancelled",
        "done",
        "error"
      ]
    },
    "TranslateTask": {
      "title": "TranslateTask",
      "description": "翻译任务状态（translate.start/status 返回值，M3）。",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/TranslateStatus"
        },
        "provider_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "style_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "风格预设 ID（null=默认风格）"
        },
        "glossary_version": {
          "type": "string",
          "description": "任务启动时的术语表内容哈希（参与 cache_key）"
        },
        "total": {
          "type": "integer"
        },
        "done": {
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "number"
        },
        "updated_at": {
          "type": "number"
        }
      },
      "required": [
        "task_id",
        "status",
        "provider_id",
        "model",
        "total",
        "done",
        "created_at",
        "updated_at"
      ]
    },
    "TranslateStats": {
      "title": "TranslateStats",
      "description": "翻译用量统计（translate.stats 返回值，M4 成本面板）。",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "tokens_in": {
          "type": "integer"
        },
        "tokens_out": {
          "type": "integer"
        },
        "estimated_cost": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "provider_id",
        "model",
        "tokens_in",
        "tokens_out",
        "estimated_cost"
      ]
    },
    "ProviderInfo": {
      "title": "ProviderInfo",
      "description": "providers.list 返回值：Provider 选择器渲染所需（M3）。",
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可用模型列表（模型下拉框）"
        },
        "needs_api_key": {
          "type": "boolean",
          "description": "是否需要密钥（MockProvider=false，前端据此显示密钥输入框）"
        },
        "supports_structured": {
          "type": "boolean",
          "description": "是否支持 response_format json_schema strict"
        },
        "base_url": {
          "type": "string",
          "description": "OpenAI 兼容端点 base_url（可配置项）"
        }
      },
      "required": [
        "provider_id",
        "display_name",
        "models",
        "needs_api_key",
        "supports_structured"
      ]
    },
    "ProviderTestResult": {
      "title": "ProviderTestResult",
      "description": "providers.test 返回值：连通性自检。",
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "latency_ms": {
          "type": "number"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider_id",
        "ok"
      ]
    }
  }
}
